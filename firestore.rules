rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario autenticado solo puede leer y escribir su propia información
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Lista de espera para interesados en «Custodio de la Palabra»
    match /custodio_interesados/{docId} {
      allow create, update: if request.auth != null && request.auth.uid == docId;
      allow read: if request.auth != null && request.auth.uid == docId;
    }

    // Foro de la comunidad Verbum (solo personas con sesión iniciada)
    match /forum_topics/{topicId} {
      // Lectura y creación permitida a todo usuario con sesión iniciada
      allow read, create: if request.auth != null;
      // Actualizar (ej. likes o contador de respuestas) para cualquier usuario autenticado
      allow update: if request.auth != null;
      // Solo el autor puede eliminar su propio tema
      allow delete: if request.auth != null && request.auth.uid == resource.data.autor_uid;

      // Respuestas dentro del tema
      match /replies/{replyId} {
        allow read, create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.autor_uid;
      }
    }
  }
}
